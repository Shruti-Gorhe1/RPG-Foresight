# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me
LOG_LEVEL=INFO
# Required in staging/production (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://__APP_NAME__-fe.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=

# ── Database / Cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rpg_foresight

# ── Local Ollama model (no cloud credentials required) ────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Install Ollama and download a model if it is not already present:
# ollama pull qwen2.5:3b

# ── Optional Azure OpenAI provider ────────────────────────────────────────────
# Set LLM_PROVIDER=azure_openai only if you want to use Azure instead of Ollama.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Azure Key Vault (optional; set *_KV_URI to source secrets from KV) ────────
AZURE_KEYVAULT_URL=https://zaf-kv-01.vault.azure.net/
# AZURE_OPENAI_API_KEY_KV_URI=https://zaf-kv-01.vault.azure.net/secrets/azure-openai-api-key
# DATABASE_URL_KV_URI=

# ── Email signal delivery (SMTP) ─────────────────────────────────────────────
# EMAIL_PROVIDER=resend uses Resend; SMTP is available for providers that accept SMTP auth.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
# RESEND_API_KEY_KV_URI=https://.../secrets/resend-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
# Optional: source SMTP_PASSWORD from Azure Key Vault instead.
# SMTP_PASSWORD_KV_URI=

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=__NAMESPACE__
TEMPORAL_TASK_QUEUE_AGENTS=__TASK_QUEUE__

# ── Zoho CRM ingestion ───────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MODULE=Tenders
# Set both domains for the Zoho data center where the CRM account lives.
ZOHO_API_DOMAIN=www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_TENANT_ID=KEC-001
ZOHO_SENDER_ENTITY_ID=KEC-ENTITY

# ── Arize Phoenix Observability ──────────────────────────────────────────────
PHOENIX_HOST=localhost
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=__APP_NAME__
# For local Phoenix, no API key or Space ID is needed. Leave both blank.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
ARIZE_SPACE_ID=
ARIZE_PHOENIX_API_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=https://zaf-phoenix.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io/v1/traces
# Arize AX (copy the Space ID from Space Settings; use AX's HTTP collector endpoint)
# PHOENIX_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces
# ARIZE_SPACE_ID=
# ARIZE_PHOENIX_API_KEY=
